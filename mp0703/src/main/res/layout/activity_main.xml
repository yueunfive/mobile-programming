<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PopupMenu 실습"
        android:textColor="#8BC34A"
        android:textSize="25sp"
        android:textStyle="bold|italic" />

    <!-- 누르면 팝업 메뉴(오름차순/내림차순) 표시 -->
    <Button
        android:id="@+id/btnSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00ACC1"
        android:text="정렬하기" />

    <!-- 왼쪽: 정렬 방향 화살표 / 가운데: 동물 목록 / 오른쪽: 정렬 전 여백 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageArrow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="invisible"
            app:srcCompat="@drawable/bg_small2big" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#8000ACC1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/animal1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image1" />

            <ImageView
                android:id="@+id/animal2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image2" />

            <ImageView
                android:id="@+id/animal3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image3" />

            <ImageView
                android:id="@+id/animal4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image4" />

            <ImageView
                android:id="@+id/animal5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image5" />

            <ImageView
                android:id="@+id/animal6"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="5dp"
                app:srcCompat="@drawable/image6" />
        </LinearLayout>

        <View
            android:id="@+id/rightSpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
