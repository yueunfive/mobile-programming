<?xml version="1.0" encoding="utf-8"?>
<!-- 항목 상태별 배경: 누름 > 선택(activated) > 일반 순서로 적용 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/item_state_pressed" android:state_pressed="true" />
    <item android:drawable="@drawable/item_state_selected" android:state_activated="true" />
    <item android:drawable="@drawable/item_state_normal" />
</selector>
