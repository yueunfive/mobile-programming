<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OptionMenu 실습"
        android:textColor="#8BC34A"
        android:textSize="25sp"
        android:textStyle="bold|italic" />

    <!-- 정답 선택지 버튼 3개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnChoice1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn1" />

        <ImageButton
            android:id="@+id/btnChoice2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn2" />

        <ImageButton
            android:id="@+id/btnChoice3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn3" />
    </LinearLayout>

    <!-- 칠판 배경 위에 'A 연산자 ? = 결과' 식 표시 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageA"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/num2" />

            <ImageView
                android:id="@+id/imageOp"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/op1" />

            <ImageView
                android:id="@+id/imageQuestion"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/op6" />

            <ImageView
                android:id="@+id/imageEqual"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/op5" />

            <ImageView
                android:id="@+id/imageResultTens"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/num8" />

            <ImageView
                android:id="@+id/imageResultOnes"
                android:layout_width="45dp"
                android:layout_height="90dp"
                app:srcCompat="@drawable/num8" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
